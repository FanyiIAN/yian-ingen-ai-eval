{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w02-model-evaluation-result-row-v0.2.0",
  "title": "Week 2 model evaluation result row",
  "type": "object",
  "required": [
    "run_id",
    "timestamp_utc",
    "benchmark_version",
    "regulation_version",
    "scenario_id",
    "split",
    "platform",
    "severity_class",
    "candidate_model_id",
    "candidate_model_revision",
    "tokenizer_revision",
    "precision",
    "device",
    "generation_config_hash",
    "seed",
    "prompt_template_version",
    "input_stimulus",
    "raw_output",
    "generation_latency_ms",
    "generation_error",
    "deterministic_audit",
    "judge_model_id",
    "judge_model_revision",
    "judge_prompt_versions",
    "judge_results",
    "task_accuracy_ratings",
    "contextual_grounding_ratings",
    "primary_failure_mode_ratings",
    "robustness_signal",
    "human_review_required",
    "human_review_reasons",
    "final_task_accuracy",
    "final_contextual_grounding",
    "final_primary_failure_mode",
    "final_score_status"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "minLength": 1},
    "benchmark_version": {"type": "string"},
    "regulation_version": {"type": "string"},
    "scenario_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
    "split": {"enum": ["development", "held_out"]},
    "platform": {"type": "string"},
    "severity_class": {"enum": [1, 3, 5]},
    "candidate_model_id": {"type": "string"},
    "candidate_model_revision": {"type": "string"},
    "tokenizer_revision": {"type": "string"},
    "precision": {"type": "string"},
    "device": {"type": "string"},
    "generation_config_hash": {"type": "string"},
    "seed": {"type": "integer"},
    "prompt_template_version": {"type": "string"},
    "input_stimulus": {"type": "string"},
    "raw_output": {"type": "string"},
    "generation_latency_ms": {"type": "number", "minimum": 0},
    "generation_error": {"type": ["string", "null"]},
    "deterministic_audit": {"type": "object"},
    "judge_model_id": {"type": "string"},
    "judge_model_revision": {"type": "string"},
    "judge_prompt_versions": {"type": "array", "minItems": 3, "maxItems": 3},
    "judge_results": {"type": "array", "minItems": 3, "maxItems": 3},
    "task_accuracy_ratings": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "integer", "minimum": 1, "maximum": 5}
    },
    "contextual_grounding_ratings": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "integer", "minimum": 1, "maximum": 5}
    },
    "primary_failure_mode_ratings": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"enum": ["unsafe", "hallucination", "off_policy", "refusal", "partial", "none"]}
    },
    "robustness_signal": {"const": "not_tested"},
    "human_review_required": {"type": "boolean"},
    "human_review_reasons": {"type": "array", "items": {"type": "string"}},
    "automated_task_accuracy": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "automated_contextual_grounding": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "automated_primary_failure_mode": {
      "type": ["string", "null"],
      "enum": ["unsafe", "hallucination", "off_policy", "refusal", "partial", "none", null]
    },
    "automated_consensus_complete": {"type": "boolean"},
    "final_task_accuracy": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "final_contextual_grounding": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
    "final_primary_failure_mode": {
      "type": ["string", "null"],
      "enum": ["unsafe", "hallucination", "off_policy", "refusal", "partial", "none", null]
    },
    "final_score_status": {
      "enum": [
        "automated_provisional_local_integration",
        "automated_consensus_provisional",
        "human_review_required_no_final_score",
        "human_adjudicated_first_pass",
        "human_adjudicated"
      ]
    },
    "human_task_accuracy": {"type": ["number", "null"]},
    "human_contextual_grounding": {"type": ["number", "null"]},
    "human_primary_failure_mode": {
      "type": ["string", "null"],
      "enum": ["unsafe", "hallucination", "off_policy", "refusal", "partial", "none", null]
    },
    "human_rationale": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
